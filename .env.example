# Copy to .env and uncomment ONE provider block. Any litellm-supported
# provider works. With no .env the agent still runs and scores, using
# fused retrieval order instead of LLM reranking.

# --- OpenAI (what we measured with) ---
RERANK_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# --- Google Gemini ---
# RERANK_MODEL=gemini/gemini-3.6-flash
# GEMINI_API_KEY=

# --- Groq (free tier, fast) ---
# RERANK_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=

# --- Anthropic ---
# RERANK_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=


